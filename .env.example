# ==============================================================================
# ORACLE DATABASE CONFIGURATION
# ==============================================================================
# Mode kết nối Oracle: "thin" (mặc định không cần cài Oracle Client) hoặc "thick"
ORACLE_MODE=thin

# Tên đăng nhập người dùng Oracle Database
ORACLE_USER=vnstock_user

# Mật khẩu người dùng Oracle
ORACLE_PASSWORD=YourStrongPasswordHere

# Oracle DSN (Data Source Name):
# Định dạng Easy Connect: host:port/service_name
# Ví dụ: localhost:1521/XEPDB1 hoặc dbhost.company.com:1521/FREEPDB1
ORACLE_DSN=localhost:1521/XEPDB1

# (Tùy chọn) Đường dẫn Oracle Client LibDir nếu dùng thick mode
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_23

# (Tùy chọn) Đường dẫn Oracle Cloud Wallet Directory nếu dùng Oracle Autonomous DB
# ORACLE_WALLET_LOCATION=C:\oracle\wallet
# ORACLE_WALLET_PASSWORD=YourWalletPassword

# Connection Pool settings
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1

# ==============================================================================
# PIPELINE EXECUTION SETTINGS
# ==============================================================================
# Khoảng nghỉ giữa các request yfinance (giây) để tránh rate limit
YFINANCE_REQUEST_DELAY_SEC=0.35

# Số lần thử lại tối đa khi gặp lỗi mạng/yfinance tạm thời
MAX_RETRIES=3

# Thời gian backoff giữa các lần thử lại (giây)
RETRY_BACKOFF_FACTOR=2.0

# Batch size cho database MERGE / INSERT (số bản ghi mỗi batch)
DB_BATCH_SIZE=1000

# File danh sách mã mặc định
DEFAULT_SYMBOLS_FILE=data/vietnam_stocks.csv

# Sàn giao dịch mặc định (phân cách bằng dấu phẩy: HOSE,HNX,UPCoM)
DEFAULT_EXCHANGES=HOSE,HNX,UPCoM
